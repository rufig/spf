{
  "comments": {
    "lineComment": "\\ ",
    "blockComment": ["( ", ")"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "wordPattern": "[^\\s]+"
}
